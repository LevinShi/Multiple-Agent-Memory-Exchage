{
  "manifest_version": 3,
  "name": "Local Agent Memory — Gemini Private Capture",
  "version": "0.2.0",
  "description": "Only capture the Gemini conversation you explicitly select, into a private local store.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "选择当前Gemini会话进行私有采集",
    "default_popup": "popup.html"
  },
  "key": ""
}
